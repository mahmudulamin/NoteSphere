          "id": "os-process-vs-thread",
          "title": "Process vs Thread",
          "blocks": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "Process: independent address space; heavier context switch.",
                "Thread: shares process memory; cheaper context switch.",
                "Threads need synchronization (locks, semaphores) to avoid races."
              ]
            }
          ]
        },
